<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.0</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-microgaming</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-microgaming.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GameInterface.MicroGaming.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.MicroGaming.Client</PackageId>
		<Title>Tgs.GameInterface.MicroGaming.Client</Title>
		<Description>Tgs.GameInterface.MicroGaming.Client</Description>
		<PackageTags>Tgs GameInterface MicroGaming Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.63.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.63.0" />
		<PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.3">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tgs.GameInterface.MicroGaming.Protos\Tgs.GameInterface.MicroGaming.Protos.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>

</Project>
